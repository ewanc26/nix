{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100, "title": "System", "type": "row" },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute",
          "steps": [{"color":"green","value":null},{"color":"yellow","value":70},{"color":"red","value":90}] },
        "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "id": 1, "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "CPU Usage",
      "type": "gauge",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "CPU %", "refId": "A" }] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute",
          "steps": [{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}] },
        "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 1 },
      "id": 2, "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Memory Usage",
      "type": "gauge",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
        "legendFormat": "Memory %", "refId": "A" }] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute",
          "steps": [{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}] },
        "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 },
      "id": 3, "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Root Disk Usage",
      "type": "gauge",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} * 100)",
        "legendFormat": "/ disk %", "refId": "A" }] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [], "max": 100, "min": 0, "thresholds": { "mode": "absolute",
          "steps": [{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}] },
        "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 },
      "id": 4, "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "/srv Disk Usage",
      "type": "gauge",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/srv\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/srv\",fstype!~\"tmpfs|overlay\"} * 100)",
        "legendFormat": "/srv disk %", "refId": "A" }] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [], "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] },
        "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 1 },
      "id": 5, "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Uptime",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "time() - node_boot_time_seconds",
        "legendFormat": "Uptime", "refId": "A" }] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [], "thresholds": { "mode": "absolute",
          "steps": [{"color":"green","value":null},{"color":"yellow","value":4},{"color":"red","value":8}] },
        "unit": "short", "decimals": 2 }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 4 },
      "id": 6, "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Load Average (15m)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "node_load15",
        "legendFormat": "Load 15m", "refId": "A" }] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [], "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] },
        "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "id": 7, "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "vertical" },
      "title": "Memory",
      "type": "stat",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes", "legendFormat": "Total", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available", "refId": "B" }
      ] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 10, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "CPU Usage Over Time",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - (avg by(cpu) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU {{cpu}}", "refId": "A" }
      ] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "bytes", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 11, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Memory Over Time",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_Cached_bytes",
          "legendFormat": "Cached", "refId": "C" }
      ] },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 101, "title": "Network", "type": "row" },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "Bps" },
        "overrides": [{ "matcher": { "id": "byName", "options": "Transmit" },
          "properties": [{ "id": "custom.transform", "value": "negative-Y" }] }] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 20, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Network Traffic (eth0)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_receive_bytes_total{device=\"eth0\"}[5m])",
          "legendFormat": "Receive", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_transmit_bytes_total{device=\"eth0\"}[5m])",
          "legendFormat": "Transmit", "refId": "B" }
      ] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "Bps" },
        "overrides": [{ "matcher": { "id": "byName", "options": "Transmit" },
          "properties": [{ "id": "custom.transform", "value": "negative-Y" }] }] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 21, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Network Traffic (tailscale0)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_receive_bytes_total{device=\"tailscale0\"}[5m])",
          "legendFormat": "Receive", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_network_transmit_bytes_total{device=\"tailscale0\"}[5m])",
          "legendFormat": "Transmit", "refId": "B" }
      ] },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 102, "title": "Disk I/O", "type": "row" },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "Bps" },
        "overrides": [{ "matcher": { "id": "byName", "options": "Write" },
          "properties": [{ "id": "custom.transform", "value": "negative-Y" }] }] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 30, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Disk I/O Throughput",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_disk_read_bytes_total[5m])",
          "legendFormat": "Read {{device}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_disk_written_bytes_total[5m])",
          "legendFormat": "Write {{device}}", "refId": "B" }
      ] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 31, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Disk I/O Latency",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_disk_read_time_seconds_total[5m]) / rate(node_disk_reads_completed_total[5m]) * 1000",
          "legendFormat": "Read {{device}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_disk_write_time_seconds_total[5m]) / rate(node_disk_writes_completed_total[5m]) * 1000",
          "legendFormat": "Write {{device}}", "refId": "B" }
      ] },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 103, "title": "Caddy", "type": "row" },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 40, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Request Rate by Status Code",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(code) (rate(caddy_http_requests_total[5m]))",
          "legendFormat": "{{code}}", "refId": "A" }
      ] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "id": 41, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Request Duration (p50/p95/p99)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by(le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by(le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by(le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99", "refId": "C" }
      ] },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 104, "title": "PostgreSQL", "type": "row" },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 50, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "DB Connections",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "pg_stat_activity_count",
          "legendFormat": "{{datname}} – {{state}}", "refId": "A" }
      ] },

    { "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" },
        "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "id": 51, "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "DB Transactions/sec",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_commit[5m])",
          "legendFormat": "commit {{datname}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_rollback[5m])",
          "legendFormat": "rollback {{datname}}", "refId": "B" }
      ] }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["server"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Server Overview",
  "uid": "server-overview",
  "version": 1
}
