{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " ",
    "color": {
      "separator": "#005f2a",
      "output": "#f0faf0"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": "#88b115"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#679500"
    },
    {
      "type": "kernel",
      "key": "KRNL",
      "keyColor": "#88b115"
    },
    {
      "type": "uptime",
      "key": "UP",
      "keyColor": "#009b22"
    },
    {
      "type": "packages",
      "key": "PKG",
      "keyColor": "#00a751"
    },
    {
      "type": "shell",
      "key": "SH",
      "keyColor": "#88b115"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#679500"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#009b22",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 9
      }
    },
    {
      "type": "disk",
      "key": "DSK",
      "keyColor": "#00a751",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 9
      }
    }
  ]
}
