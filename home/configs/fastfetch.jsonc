{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "large",
    "color": {
      "1": "32",
      "2": "28"
    },
    "paddingTop": 1,
    "paddingLeft": 2,
    "paddingRight": 4
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}",
      "color": {
        "user": "bright-green",
        "host": "green"
      }
    },
    {
      "type": "separator",
      "string": "─────────────────────────────────"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "green"
    },
    {
      "type": "host",
      "key": "  Host",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "  Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "  Packages",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  Display",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "  DE",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "green"
    },
    {
      "type": "wmtheme",
      "key": "  WM Theme",
      "keyColor": "green"
    },
    {
      "type": "theme",
      "key": "  Theme",
      "keyColor": "green"
    },
    {
      "type": "icons",
      "key": "  Icons",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "keyColor": "bright-green"
    },
    {
      "type": "gpu",
      "key": "  GPU",
      "keyColor": "bright-green"
    },
    {
      "type": "memory",
      "key": "  Memory",
      "keyColor": "bright-green"
    },
    {
      "type": "swap",
      "key": "  Swap",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  Disk (/)",
      "keyColor": "bright-green"
    },
    {
      "type": "separator",
      "string": "─────────────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}