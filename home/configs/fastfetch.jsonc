{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    },
    "color": {
      "1": "#245327",
      "2": "#2e6b30",
      "3": "#3f7f3f",
      "4": "#4f944f",
      "5": "#60a960",
      "6": "#72bf72",
      "7": "#88b115"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "separator": "#005f2a",
      "output": "#f0faf0"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": "#88b115"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#679500"
    },
    {
      "type": "kernel",
      "key": "KRNL",
      "keyColor": "#88b115"
    },
    {
      "type": "uptime",
      "key": "UP",
      "keyColor": "#009b22"
    },
    {
      "type": "packages",
      "key": "PKG",
      "keyColor": "#00a751"
    },
    {
      "type": "shell",
      "key": "SH",
      "keyColor": "#88b115"
    },
    {
      "type": "terminal",
      "key": "TERM",
      "keyColor": "#009b22"
    },
    {
      "type": "display",
      "key": "DSP",
      "keyColor": "#245327"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#005f2a"
    },
    {
      "type": "theme",
      "key": "THEME",
      "keyColor": "#88b115"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#679500"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#88b115"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#009b22",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 9
      }
    },
    {
      "type": "disk",
      "key": "DSK",
      "keyColor": "#00a751",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 9
      }
    }
  ]
}