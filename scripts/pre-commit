#!/usr/bin/env bash
# Pre-commit hook: Validate Nix configuration before committing

set -e

echo "Validating Nix configuration..."

# Check if nix flake check works
if ! nix flake check --no-build 2>/dev/null; then
    echo "❌ Nix flake validation failed!"
    echo "Please fix the errors before committing."
    exit 1
fi

echo "✓ Nix configuration is valid"
exit 0
