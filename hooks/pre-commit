#!/usr/bin/env bash
# Pre-commit hook — runs automatically before every commit and as part of
# the nixos-upgrade-push systemd service after auto-upgrades.
#
# Checks staged files only, so it's fast and non-intrusive.
# Formatters (nixfmt, shfmt, rustfmt, taplo, prettier) auto-fix and re-stage.
# Linters (shellcheck, clippy) still block on failure — they need human fixes.
#
# Tools used (all present in myConfig.packages.development):
#   nixfmt-rfc-style  — Nix formatter
#   shfmt + shellcheck — Shell formatter and linter
#   rustfmt + clippy  — Rust formatter and linter (via rustup/cargo)
#   taplo             — TOML formatter
#   markdownlint-cli  — Markdown linter
#   prettier          — JSON, JSONC, YAML, CSS, JS, HTML formatter

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Collect staged files matching an extended-regex pattern into a global array.
# Uses while-read rather than mapfile for bash 3 compatibility (macOS ships
# bash 3; mapfile requires bash 4+).  local -n (namerefs) also requires 4.3+
# so we accept a fixed global array name _FILES and copy out as needed.
_staged_files() {
  _FILES=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && _FILES+=("$line")
  done < <(git diff --cached --name-only --diff-filter=ACM | grep -E "$1" || true)
}

_staged_files '\.nix$';                              NIX_FILES=("${_FILES[@]}")
_staged_files '\.sh$';                               SH_FILES=("${_FILES[@]}")
_staged_files '\.rs$';                               RS_FILES=("${_FILES[@]}")
_staged_files '\.toml$';                             TOML_FILES=("${_FILES[@]}")
_staged_files '\.md$';                               MD_FILES=("${_FILES[@]}")
_staged_files '\.(json|jsonc|yaml|yml|css|js|html)$'; PRETTIER_FILES=("${_FILES[@]}")

FAILED=0

# ── Nix parse check ───────────────────────────────────────────────────────────
# Runs before nixfmt: a file that does not parse cannot be formatted either, and
# `set -e` would abort the hook mid-run with nixfmt's error rather than a clear
# message naming the file. This is the check that would have caught the
# modules/server/infra/* breakage, where a comment block replaced a module
# header and the server config stopped evaluating entirely.
if [ "${#NIX_FILES[@]}" -gt 0 ]; then
  echo "→ nix: parsing staged .nix files..."
  PARSE_FAILED=0
  for file in "${NIX_FILES[@]}"; do
    if ! nix-instantiate --parse "$file" >/dev/null; then
      echo "  ✗ $file does not parse"
      PARSE_FAILED=1
    fi
  done
  if [ "$PARSE_FAILED" -ne 0 ]; then
    echo ""
    echo "✗ syntax error in staged Nix files — commit blocked"
    exit 1
  fi
  echo "  ✓ all .nix files parse"
fi

# ── Nix formatting ────────────────────────────────────────────────────────────
if [ "${#NIX_FILES[@]}" -gt 0 ]; then
  echo "→ nixfmt: formatting staged .nix files..."
  for file in "${NIX_FILES[@]}"; do
    nixfmt "$file"
  done
  git add "${NIX_FILES[@]}"
  echo "  ✓ all .nix files formatted and re-staged"
fi

# ── Shell formatting ──────────────────────────────────────────────────────────
if [ "${#SH_FILES[@]}" -gt 0 ]; then
  echo "→ shfmt: formatting staged .sh files..."
  for file in "${SH_FILES[@]}"; do
    shfmt -w "$file"
  done
  git add "${SH_FILES[@]}"
  echo "  ✓ all .sh files formatted and re-staged"
fi

# ── Shell linting ─────────────────────────────────────────────────────────────
if [ "${#SH_FILES[@]}" -gt 0 ]; then
  echo "→ shellcheck: linting staged .sh files..."
  for file in "${SH_FILES[@]}"; do
    if ! shellcheck "$file"; then
      FAILED=1
    fi
  done
  [ "$FAILED" -eq 0 ] && echo "  ✓ shellcheck passed"
fi

# ── Rust formatting + linting ─────────────────────────────────────────────────
if [ "${#RS_FILES[@]}" -gt 0 ]; then
  # Find unique Cargo.toml roots containing the staged files
  declare -A seen_roots
  for file in "${RS_FILES[@]}"; do
    dir="$(dirname "$file")"
    while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
      if [ -f "$dir/Cargo.toml" ]; then
        seen_roots["$dir"]=1
        break
      fi
      dir="$(dirname "$dir")"
    done
  done

  for root in "${!seen_roots[@]}"; do
    echo "→ rustfmt: formatting $root..."
    cargo fmt --manifest-path "$root/Cargo.toml" 2>/dev/null

    # Re-stage any .rs files under this root
    ROOT_RS_FILES=()
    while IFS= read -r line; do
      [[ -n "$line" ]] && ROOT_RS_FILES+=("$line")
    done < <(printf '%s\n' "${RS_FILES[@]}" | grep "^$root/" || true)
    [ "${#ROOT_RS_FILES[@]}" -gt 0 ] && git add "${ROOT_RS_FILES[@]}"
    echo "  ✓ rustfmt applied and re-staged"

    echo "→ clippy: linting $root..."
    if ! cargo clippy --manifest-path "$root/Cargo.toml" -- -D warnings 2>/dev/null; then
      FAILED=1
    else
      echo "  ✓ clippy passed"
    fi
  done
fi

# ── TOML formatting ───────────────────────────────────────────────────────────
if [ "${#TOML_FILES[@]}" -gt 0 ]; then
  echo "→ taplo: formatting staged .toml files..."
  for file in "${TOML_FILES[@]}"; do
    taplo fmt "$file" 2>/dev/null
  done
  git add "${TOML_FILES[@]}"
  echo "  ✓ all .toml files formatted and re-staged"
fi

# ── Markdown linting ──────────────────────────────────────────────────────────
if [ "${#MD_FILES[@]}" -gt 0 ]; then
  echo "→ markdownlint: checking staged .md files..."
  if ! markdownlint "${MD_FILES[@]}"; then
    FAILED=1
  else
    echo "  ✓ markdownlint passed"
  fi
fi

# ── Prettier (JSON, JSONC, YAML, CSS, JS, HTML) ───────────────────────────────
if [ "${#PRETTIER_FILES[@]}" -gt 0 ]; then
  echo "→ prettier: formatting staged files..."
  prettier --write "${PRETTIER_FILES[@]}"
  git add "${PRETTIER_FILES[@]}"
  echo "  ✓ prettier applied and re-staged"
fi

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "✗ pre-commit checks failed — commit blocked"
  exit 1
fi

exit 0
